    "游標停在 Dock 圖示上，即可預覽該 App 的所有視窗。": {
      "comment": "Onboarding subtitle",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك المؤشر على أيقونة في Dock لمعاينة جميع نوافذ ذلك التطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa el punter sobre una icona del Dock per previsualitzar totes les finestres d’aquella app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte ukazatel na ikoně v Docku a zobrazí se náhled všech oken dané aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold markøren over et symbol i Dock for at se forhåndsvisninger af alle appens vinduer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege den Zeiger auf ein Dock-Symbol, um alle Fenster dieser App zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τον δείκτη πάνω σε ένα εικονίδιο του Dock για προεπισκόπηση όλων των παραθύρων της εφαρμογής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest the pointer on a Dock icon to preview all of that app’s windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el puntero sobre un icono del Dock para ver una vista previa de todas las ventanas de esa app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä osoitinta Dockin symbolin päällä, niin näet esikatselun apin kaikista ikkunoista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le pointeur sur une icône du Dock pour afficher toutes les fenêtres de cette app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר את הסמן על צלמית ב־Dock כדי לראות תצוגה מקדימה של כל החלונות של אותו יישום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ऐप की सभी विंडो का प्रीव्यू देखने के लिए पॉइंटर को उसके Dock आइकॉन पर रोकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržite pokazivač na ikoni u Docku za pregled svih prozora te aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidd a mutatót egy Dock-ikonra, és megjelenik az app összes ablakának előnézete."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan penunjuk ke ikon Dock untuk melihat pratinjau semua jendela app tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona il puntatore su un’icona del Dock per vedere l’anteprima di tutte le finestre di quell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのアイコンにポインタを置くと、そのAppのすべてのウインドウをプレビューできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘 위에 포인터를 올려 두면 해당 앱의 모든 윈도우를 미리 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan penuding pada ikon Dock untuk pratonton semua tetingkap app tersebut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold pekeren over et symbol i Dock for å forhåndsvise alle vinduene til appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de aanwijzer op een Dock-symbool om alle vensters van die app te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj wskaźnik na ikonie w Docku, aby zobaczyć podgląd wszystkich okien tej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o cursor sobre um ícone do Dock para pré-visualizar todas as janelas desse app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o cursor sobre um ícone da Dock para pré-visualizar todas as janelas dessa app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține cursorul pe o pictogramă din Dock pentru a previzualiza toate ferestrele aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель на значок в Dock, чтобы увидеть все окна этого приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte ukazovateľ na ikone v Docku a zobrazí sa náhľad všetkých okien danej aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll pekaren över en symbol i Dock för att förhandsvisa alla appens fönster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางตัวชี้บนไอคอนใน Dock เพื่อดูตัวอย่างหน้าต่างทั้งหมดของแอปนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın tüm pencerelerini önizlemek için imleci bir Dock simgesinin üzerinde tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть курсор на значок у Dock, щоб переглянути всі вікна цієї програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt con trỏ lên một biểu tượng trên Dock để xem trước tất cả cửa sổ của ứng dụng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针停在程序坞图标上，即可预览该 App 的所有窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標停在 Dock 圖示上，即可預覽該 App 的所有視窗。"
          }
        }
      }
    },
