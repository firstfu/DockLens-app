    "滑過「行事曆」時顯示今天的行程": {
      "comment": "Settings toggle. 'Calendar' is Apple's Calendar app — use its localized macOS app name",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار أحداث اليوم عند التمرير فوق التقويم"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els esdeveniments d’avui en passar per sobre del Calendari"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit dnešní události po najetí na Kalendář"
