    "W 關閉視窗、M 縮小或還原、H 隱藏 App、Q 結束 App": {
      "comment": "Settings toggle subtitle. Keep the letters W M H Q unchanged (they are physical keys)",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏W يغلق النافذة، M يصغّرها أو يستعيدها، H يخفي التطبيق، Q ينهي التطبيق"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "W tanca la finestra, M la minimitza o la restaura, H amaga l’app, Q surt de l’app"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "W zavře okno, M ho minimalizuje nebo obnoví, H skryje aplikaci, Q ukončí aplikaci"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "W lukker vinduet, M minimerer eller gendanner det, H skjuler appen, Q afslutter appen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W schließt das Fenster, M legt es im Dock ab oder stellt es wieder her, H blendet die App aus, Q beendet die App"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "W: κλείσιμο παραθύρου, M: ελαχιστοποίηση ή επαναφορά, H: απόκρυψη εφαρμογής, Q: έξοδος από την εφαρμογή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "W closes the window, M minimizes or restores it, H hides the app, Q quits the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "W cierra la ventana, M la minimiza o la restaura, H oculta la app, Q sale de la app"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "W sulkee ikkunan, M pienentää tai palauttaa sen, H kätkee apin, Q lopettaa apin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "W ferme la fenêtre, M la place dans le Dock ou la restaure, H masque l’app, Q quitte l’app"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏W סוגר את החלון, M ממזער או משחזר אותו, H מסתיר את היישום, Q יוצא מהיישום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "W विंडो बंद करता है, M उसे छोटा या पुनर्स्थापित करता है, H ऐप छिपाता है, Q ऐप बंद करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "W zatvara prozor, M ga minimizira ili vraća, H skriva aplikaciju, Q zatvara aplikaciju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "W: ablak bezárása, M: kis méret vagy visszaállítás, H: app elrejtése, Q: kilépés az appból"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "W menutup jendela, M meminimalkan atau memulihkannya, H menyembunyikan app, Q keluar dari app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "W chiude la finestra, M la riduce a icona o la ripristina, H nasconde l’app, Q esce dall’app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "W：ウインドウを閉じる、M：しまう／元に戻す、H：Appを非表示、Q：Appを終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "W는 윈도우 닫기, M은 최소화 또는 복원, H는 앱 가리기, Q는 앱 종료"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "W menutup tetingkap, M meminimumkan atau memulihkannya, H menyembunyikan app, Q keluar dari app"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "W lukker vinduet, M minimerer eller gjenoppretter det, H skjuler appen, Q avslutter appen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sluit het venster, M minimaliseert of herstelt het, H verbergt de app, Q stopt de app"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zamyka okno, M minimalizuje lub przywraca je, H ukrywa aplikację, Q kończy aplikację"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "W fecha a janela, M minimiza ou restaura, H oculta o app, Q encerra o app"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "W fecha a janela, M minimiza ou restaura, H oculta a app, Q sai da app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "W închide fereastra, M o minimizează sau o restaurează, H ascunde aplicația, Q iese din aplicație"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "W — закрыть окно, M — свернуть или развернуть, H — скрыть приложение, Q — завершить приложение"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "W zatvorí okno, M ho minimalizuje alebo obnoví, H skryje aplikáciu, Q ukončí aplikáciu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "W stänger fönstret, M minimerar eller återställer det, H gömmer appen, Q avslutar appen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "W ปิดหน้าต่าง, M ย่อหรือคืนค่า, H ซ่อนแอป, Q ออกจากแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "W pencereyi kapatır, M simge durumuna küçültür veya geri getirir, H uygulamayı gizler, Q uygulamadan çıkar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "W — закрити вікно, M — згорнути або відновити, H — сховати програму, Q — вийти з програми"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "W đóng cửa sổ, M thu nhỏ hoặc khôi phục, H ẩn ứng dụng, Q thoát ứng dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "W 关闭窗口、M 最小化或还原、H 隐藏 App、Q 退出 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "W 關閉視窗、M 縮小或還原、H 隱藏 App、Q 結束 App"
          }
        }
      }
    },
