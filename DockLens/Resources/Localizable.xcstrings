          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ve yarın etkinlik yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає подій на сьогодні й завтра"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có sự kiện hôm nay hoặc ngày mai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天和明天都没有日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天和明天都沒有行程"
          }
        }
