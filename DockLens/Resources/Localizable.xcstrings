    "偵測游標停在哪個 Dock 圖示、切換與關閉視窗": {
      "comment": "Onboarding: what the Accessibility permission is used for",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمعرفة أيقونة Dock التي تشير إليها، وللتبديل بين النوافذ وإغلاقها"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per detectar a quina icona del Dock apuntes, i per canviar i tancar finestres"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke zjištění, na kterou ikonu v Docku ukazujete, a k přepínání a zavírání oken"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at se, hvilket symbol i Dock du peger på, og for at skifte og lukke vinduer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um zu erkennen, auf welches Dock-Symbol du zeigst, und um Fenster zu wechseln und zu schließen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τον εντοπισμό του εικονιδίου του Dock στο οποίο δείχνετε και για εναλλαγή και κλείσιμο παραθύρων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see which Dock icon you’re pointing at, and to switch and close windows"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detectar a qué icono del Dock apuntas, y para cambiar de ventana y cerrarlas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen tunnistamiseen, minkä Dockin symbolin päällä osoitin on, sekä ikkunoiden vaihtamiseen ja sulkemiseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour savoir quelle icône du Dock vous pointez, et pour changer de fenêtre ou en fermer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לזהות על איזו צלמית ב־Dock הסמן מצביע, וכדי לעבור בין חלונות ולסגור אותם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पता लगाने के लिए कि आप किस Dock आइकॉन पर पॉइंट कर रहे हैं, और विंडो स्विच व बंद करने के लिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prepoznavanje ikone u Docku na koju pokazujete te za prebacivanje i zatvaranje prozora"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Annak érzékeléséhez, hogy melyik Dock-ikonra mutatsz, valamint az ablakok közötti váltáshoz és bezárásukhoz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mendeteksi ikon Dock yang Anda tunjuk, serta beralih dan menutup jendela"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rilevare a quale icona del Dock stai puntando e per passare da una finestra all’altra e chiuderle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタがどのDockアイコン上にあるかを検出し、ウインドウを切り替えたり閉じたりするため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 가리키는 Dock 아이콘을 감지하고 윈도우를 전환하거나 닫기 위해 사용"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengesan ikon Dock yang anda tuding, serta menukar dan menutup tetingkap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å se hvilket symbol i Dock du peker på, og for å bytte og lukke vinduer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te zien naar welk Dock-symbool je wijst en om vensters te wisselen en te sluiten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wykrywać, nad którą ikoną w Docku jest wskaźnik, oraz przełączać i zamykać okna"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detectar o ícone do Dock sob o cursor e para alternar e fechar janelas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detetar o ícone da Dock sob o cursor e para alternar e fechar janelas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a detecta pictograma din Dock pe care o indici și pentru a comuta și închide ferestre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы определять, на какой значок в Dock наведен указатель, а также переключать и закрывать окна"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zistenie, na ktorú ikonu v Docku ukazujete, a na prepínanie a zatváranie okien"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att se vilken symbol i Dock du pekar på och för att växla och stänga fönster"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อตรวจหาว่าคุณชี้ไอคอนใดใน Dock และเพื่อสลับและปิดหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi Dock simgesinin üzerinde olduğunuzu algılamak, pencereler arasında geçiş yapmak ve pencereleri kapatmak için"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб визначати, на який значок у Dock наведено курсор, а також перемикати й закривати вікна"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để biết con trỏ đang chỉ vào biểu tượng nào trên Dock, cũng như để chuyển và đóng cửa sổ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于检测指针停在哪个程序坞图标上，以及切换和关闭窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測游標停在哪個 Dock 圖示、切換與關閉視窗"
          }
        }
      }
    },
