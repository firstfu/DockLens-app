    "授權後即自動生效，不需重新啟動。": {
      "comment": "Onboarding footnote",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسري مفعوله فور السماح — لا حاجة لإعادة التشغيل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’aplica tan bon punt ho permetis, sense reiniciar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeví se hned po povolení — bez nutnosti restartu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træder i kraft, så snart du tillader det – ingen genstart nødvendig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirkt sofort nach dem Erlauben – kein Neustart nötig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει αμέσως μόλις το επιτρέψετε – δεν απαιτείται επανεκκίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect as soon as you allow it — no restart needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica en cuanto lo permitas, sin reiniciar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulee voimaan heti, kun sallit sen – uudelleenkäynnistystä ei tarvita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet dès que vous l’autorisez, sans redémarrage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נכנס לתוקף מיד לאחר האישור — אין צורך בהפעלה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति देते ही लागू हो जाता है — रीस्टार्ट की ज़रूरत नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjenjuje se čim dopustite – nije potrebno ponovno pokretanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az engedélyezés után azonnal érvénybe lép – nincs szükség újraindításra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung berlaku setelah Anda mengizinkan — tidak perlu memulai ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha effetto appena lo consenti, senza riavviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可するとすぐに有効になります。再起動は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 바로 적용되며 재시동할 필요가 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkuat kuasa sebaik sahaja anda membenarkannya — tidak perlu memulakan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trer i kraft med en gang du tillater det – ingen omstart nødvendig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt direct zodra je toestemming geeft — opnieuw starten is niet nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa od razu po udzieleniu zgody — bez ponownego uruchamiania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra em vigor assim que você permitir — não é preciso reiniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra em vigor assim que permitir — não é necessário reiniciar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intră în vigoare imediat ce acorzi permisiunea – nu e necesară repornirea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вступает в силу сразу после разрешения — перезапуск не нужен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejaví sa hneď po povolení — bez nutnosti reštartu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börjar gälla direkt när du tillåter det – ingen omstart behövs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผลทันทีที่คุณอนุญาต ไม่ต้องเปิด DockLens ใหม่"
