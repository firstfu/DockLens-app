            "state": "translated",
            "value": "Mostrar la vista previa aunque la app no tenga ventanas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä esikatselu, vaikka apilla ei ole ikkunoita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l’aperçu même si l’app n’a aucune fenêtre"
          }
        },
        "he": {
          "stringUnit": {
