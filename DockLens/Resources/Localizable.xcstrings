    "允許讀取行事曆，即可在這裡看到今天的行程": {
      "comment": "Agenda message; 'Calendar' = Apple Calendar app / calendars data",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى التقويم لرؤية أحداث اليوم هنا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés al Calendari per veure aquí els esdeveniments d’avui"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup ke Kalendáři a uvidíte tu dnešní události"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang til Kalender for at se dagens begivenheder her"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Kalender, um hier die heutigen Ereignisse zu sehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την πρόσβαση στο Ημερολόγιο για να βλέπετε εδώ τα σημερινά συμβάντα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to Calendar to see today’s events here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Calendario para ver aquí los eventos de hoy"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli pääsy Kalenteriin, niin näet tämän päivän tapahtumat tässä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à Calendrier pour voir ici les événements du jour"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גישה ל״לוח שנה״ כדי לראות כאן את אירועי היום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के इवेंट यहाँ देखने के लिए कैलेंडर का ऐक्सेस दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite pristup Kalendaru da biste ovdje vidjeli današnje događaje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Naptár elérését, hogy itt lásd a mai eseményeket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke Kalender untuk melihat acara hari ini di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a Calendario per vedere qui gli eventi di oggi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスを許可すると、ここに今日の予定が表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근을 허용하면 여기에서 오늘의 이벤트를 볼 수 있습니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses kepada Kalendar untuk melihat acara hari ini di sini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til Kalender for å se dagens hendelser her"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot Agenda om hier de activiteiten van vandaag te zien"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Kalendarza, aby widzieć tutaj dzisiejsze wydarzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Calendário para ver os eventos de hoje aqui"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Calendário para ver aqui os eventos de hoje"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul la Calendar pentru a vedea aici evenimentele de azi"
