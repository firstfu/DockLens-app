    "App 沒有視窗時仍顯示面板": {
      "comment": "Settings toggle",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار المعاينة حتى عندما لا يكون للتطبيق نوافذ"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la previsualització encara que l’app no tingui finestres"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit náhled, i když aplikace nemá žádná okna"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis forhåndsvisning, selv når en app ikke har vinduer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau auch anzeigen, wenn eine App keine Fenster hat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση προεπισκόπησης ακόμη κι αν η εφαρμογή δεν έχει παράθυρα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
